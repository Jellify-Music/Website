---
import { Image } from 'astro:assets'
import {
	mdiAlbum,
	mdiArrowRight,
	mdiCar,
	mdiCast,
	mdiDownload,
	mdiDownloadCircleOutline,
	mdiShieldCheckOutline,
	mdiShuffleVariant,
} from '@mdi/js'
import homeScreenshot from '@/assets/screenshots/home.png'
import playerScreenshot from '@/assets/screenshots/player.png'
import Icon from '@/components/Icon.astro'
import { alternativeDownloads, GITHUB_LINK, navLinks, storeLinks } from '@/config'
import { formatPostDate, getPosts } from '@/config/blog'
import Layout from '../layouts/Layout.astro'

const [latestPost] = await getPosts()

const features = [
	{
		icon: mdiAlbum,
		title: 'Your library, front and center',
		body: 'Artwork-forward browsing across artists, albums, playlists, and tracks, with a home screen built from what you actually listen to.',
	},
	{
		icon: mdiCar,
		title: 'CarPlay and Android Auto',
		body: 'Browse your artists, albums, playlists, and queue from the dashboard without reaching for your phone.',
	},
	{
		icon: mdiCast,
		title: 'Google Cast',
		body: 'Send your whole queue to a speaker and keep control of it from the app and your volume buttons.',
	},
	{
		icon: mdiDownloadCircleOutline,
		title: 'Offline playback',
		body: 'Download music to your device for flights, road trips, and anywhere your server can’t reach.',
	},
	{
		icon: mdiShuffleVariant,
		title: 'Rediscover what you own',
		body: 'Instant Mixes, similar artists, and suggestions powered by your Jellyfin server surface music you forgot you had.',
	},
	{
		icon: mdiShieldCheckOutline,
		title: 'No ads, no tracking',
		body: 'Jellify talks to your server and nothing else. No accounts, no analytics, and error reporting is opt-in.',
	},
]
---

<Layout title='Jellify - A music player for Jellyfin'>
	<main>
		<section class='hero'>
			<div class='hero-copy'>
				<p class='eyebrow'>Free and open source</p>
				<h1>A music player for <span>Jellyfin</span></h1>
				<p class='lede'>
					Jellify brings your self-hosted music library to iOS and Android with an interface that feels
					right at home next to the big streaming apps.
				</p>

				<!-- Points at the download section until the script below detects a phone -->
				<a
					id='download-button'
					class='download'
					href='#download'
					data-ios-href={storeLinks.ios.href}
					data-android-href={storeLinks.android.href}
				>
					<Icon class='platform-default' path={mdiDownload} />
					<Icon class='platform-ios' path={storeLinks.ios.icon} />
					<Icon class='platform-android' path={storeLinks.android.icon} />
					<span class='platform-default'>Download Jellify</span>
					<span class='platform-ios'>Download on the {storeLinks.ios.label}</span>
					<span class='platform-android'>Get it on {storeLinks.android.label}</span>
				</a>

				<p class='note'>
					Requires a <a href='https://jellyfin.org'>Jellyfin server</a>.
					<a href='#download'>All download options</a>
				</p>
			</div>

			<div class='screenshots'>
				<Image
					class='phone back'
					src={homeScreenshot}
					alt='The Jellify home screen showing recent artists, recently played albums, and most played artists'
					widths={[240, 480]}
					sizes='15rem'
					loading='eager'
				/>
				<Image
					class='phone front'
					src={playerScreenshot}
					alt='The Jellify now playing screen with album artwork and playback controls'
					widths={[260, 520]}
					sizes='16.25rem'
					loading='eager'
				/>
			</div>
		</section>

		<section class='features' aria-labelledby='features-heading'>
			<h2 id='features-heading'>Everything you want, nothing you don’t</h2>
			<ul>
				{
					features.map((feature) => (
						<li>
							<Icon path={feature.icon} />
							<h3>{feature.title}</h3>
							<p>{feature.body}</p>
						</li>
					))
				}
			</ul>
		</section>

		<section id='download' class='downloads' aria-labelledby='download-heading'>
			<h2 id='download-heading'>Get Jellify</h2>
			<p class='section-lede'>Free on both app stores, with no ads or in-app purchases.</p>

			<ul class='stores'>
				{
					Object.values(storeLinks).map((store) => (
						<li>
							<a class='store' href={store.href}>
								<Icon path={store.icon} />
								<span>
									<strong>{store.label}</strong>
									<small>{store.description}</small>
								</span>
							</a>
						</li>
					))
				}
			</ul>

			<h3>Other ways to download</h3>
			<ul class='alternatives'>
				{
					alternativeDownloads.map((link) => (
						<li>
							<a href={link.href}>
								<Icon path={link.icon} />
								<span>
									<strong>{link.label}</strong>
									<small>{link.description}</small>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		{
			latestPost && (
				<section class='latest' aria-label='Latest blog post'>
					<a href={`/blog/${latestPost.id}`}>
						<span class='eyebrow'>From the blog · {formatPostDate(latestPost.data.date)}</span>
						<strong>{latestPost.data.title}</strong>
						<Icon path={mdiArrowRight} />
					</a>
				</section>
			)
		}
	</main>

	<footer>
		<p>
			Jellify is <a href={GITHUB_LINK}>MIT licensed</a> and built by volunteers.
		</p>
		<ul>
			{
				navLinks.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</footer>
</Layout>

<script>
	// Send phones straight to their storefront. iPadOS reports a desktop Mac user agent, so check for touch too
	const button = document.getElementById('download-button')
	const userAgent = navigator.userAgent
	const isIOS = /iPhone|iPad|iPod/.test(userAgent) || (/Macintosh/.test(userAgent) && navigator.maxTouchPoints > 1)
	const isAndroid = /Android/.test(userAgent)
	const platform = isIOS ? 'ios' : isAndroid ? 'android' : null

	if (button && platform) {
		button.dataset.platform = platform
		button.setAttribute('href', button.dataset[`${platform}Href`] ?? '#download')
	}
</script>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 1rem;
	}

	a {
		color: var(--primary);
	}

	h2 {
		margin: 0;
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-align: center;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--success);
	}

	/* Hero */

	.hero {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: 3rem;
		padding: 3rem 0 4rem;
	}

	@media (min-width: 56rem) {
		.hero {
			grid-template-columns: 1.1fr 1fr;
			padding: 5rem 0 6rem;
		}
	}

	h1 {
		margin: 0.75rem 0 0;
		font-size: clamp(2.5rem, 7vw, 4rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	h1 span {
		color: var(--primary);
	}

	.lede {
		margin: 1.25rem 0 0;
		max-width: 34rem;
		font-size: 1.125rem;
		color: var(--neutral);
	}

	.download {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: 2rem;
		padding: 0.875rem 1.5rem;
		border-radius: 4px;
		background-color: var(--primary);
		color: var(--background);
		font-size: 1.125rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 150ms ease, box-shadow 150ms ease;
	}

	.download:hover,
	.download:focus-visible {
		box-shadow: 0 0px 24px -8px var(--border-color);
	}

	/* Only the label and icon for the detected platform are shown */
	.download :global(.platform-ios),
	.download :global(.platform-android),
	.download[data-platform='ios'] :global(.platform-default),
	.download[data-platform='android'] :global(.platform-default) {
		display: none;
	}

	.download[data-platform='ios'] :global(.platform-ios),
	.download[data-platform='android'] :global(.platform-android) {
		display: inline;
	}

	.note {
		margin: 1rem 0 0;
		font-size: 0.9375rem;
		color: var(--neutral);
	}

	.note a + a {
		margin-left: 0.5rem;
		font-weight: 600;
	}

	.screenshots {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		padding: 0 1rem;
	}

	.screenshots :global(.phone) {
		width: 15rem;
		max-width: 46%;
		height: auto;
		border-radius: 1.75rem;
		/* Device bezel stays dark in both themes, like the phone it frames */
		border: 2px solid var(--border-color);
		box-shadow: 0 24px 48px -24px rgba(12, 6, 34, 0.6);
	}

	.screenshots :global(.phone.back) {
		transform: rotate(-6deg) translateX(1.5rem);
		opacity: 0.9;
	}

	.screenshots :global(.phone.front) {
		width: 16.25rem;
		position: relative;
		transform: rotate(3deg) translateX(-1.5rem) translateY(1.5rem);
	}

	/* Features */

	.features {
		padding: 4rem 0;
	}

	.features ul {
		list-style: none;
		margin: 2.5rem 0 0;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 40rem) {
		.features ul {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 60rem) {
		.features ul {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.features li {
		padding: 1.5rem;
		border-radius: 14px;
		background-color: var(--background-50);
	}

	.features li :global(.icon) {
		width: 2rem;
		height: 2rem;
		color: var(--primary);
	}

	h3 {
		margin: 0.75rem 0 0.375rem;
		font-size: 1.125rem;
		font-weight: 700;
	}

	.features p {
		margin: 0;
		color: var(--neutral);
	}

	/* Downloads */

	.downloads {
		padding: 4rem 0;
		scroll-margin-top: 4rem;
	}

	.section-lede {
		margin: 0.75rem 0 0;
		text-align: center;
		color: var(--neutral);
	}

	.downloads ul {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.downloads ul a {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 1rem;
		color: var(--color);
		text-decoration: none;
		border: 2px solid var(--border-color);
		border-radius: 14px;
		padding: 1rem 1.25rem;
	}

	.downloads ul a:hover,
	.downloads ul a:focus-visible {
		border-color: var(--primary);
	}

	.downloads ul span {
		display: flex;
		flex-direction: column;
	}

	.downloads small {
		font-size: 0.9375rem;
		color: var(--neutral);
	}

	.stores {
		margin: 2rem auto 0;
		max-width: 44rem;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
	}

	.stores :global(.icon) {
		width: 2.5rem;
		height: 2.5rem;
		color: var(--primary);
	}

	.stores strong {
		font-size: 1.25rem;
	}

	.downloads h3 {
		margin-top: 3rem;
		text-align: center;
	}

	.alternatives {
		margin: 1.25rem 0 0;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
	}

	.alternatives a {
		align-items: flex-start;
	}

	.alternatives :global(.icon) {
		width: 1.5rem;
		height: 1.5rem;
		margin-top: 0.125rem;
		color: var(--primary);
	}

	/* Latest post */

	.latest {
		padding: 0 0 4rem;
	}

	.latest a {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 1rem;
		row-gap: 0.25rem;
		padding: 1.25rem 1.5rem;
		border-radius: 14px;
		background-color: var(--background-50);
		color: var(--color);
		text-decoration: none;
	}

	.latest .eyebrow {
		flex-basis: 100%;
	}

	.latest strong {
		font-size: 1.25rem;
	}

	.latest :global(.icon) {
		color: var(--primary);
		transition: transform 150ms ease;
	}

	.latest a:hover :global(.icon),
	.latest a:focus-visible :global(.icon) {
		transform: translateX(4px);
	}

	/* Footer */

	footer {
		max-width: 72rem;
		margin: 0 auto;
		padding: 2rem 1rem 3rem;
		border-top: 1px solid var(--background-50);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		color: var(--neutral);
		font-size: 0.9375rem;
	}

	footer p {
		margin: 0;
	}

	footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.25rem;
	}

	footer ul a {
		color: var(--neutral);
		text-decoration: none;
	}

	footer ul a:hover,
	footer ul a:focus-visible {
		color: var(--primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.download,
		.latest :global(.icon) {
			transition: none;
		}
	}
</style>
