---
import links from '../config'
import Layout from '../layouts/Layout.astro'

---

<Layout>
	<main>
		<div class='logo' role='img' aria-label='Jellify'></div>

		<nav>
			{
				links.map((link) => (
					<a href={link.href}>
						<svg class='icon' viewBox='0 0 24 24' aria-hidden='true'>
							<path d={link.icon} />
						</svg>
						{link.label}
					</a>
				))
			}
		</nav>
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 1.5rem;
	}

	/* The logo is single-color, so mask it and cycle the fill between brand colors */
	.logo {
		width: 180px;
		height: 180px;
		background-color: var(--primary);
		mask: url(/jellifyBlack.svg) center / contain no-repeat;
		animation: logo-color 6s ease-in-out infinite alternate;
	}

	@keyframes logo-color {
		from {
			background-color: var(--primary);
		}
		to {
			background-color: var(--success);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.logo {
			animation: none;
		}
	}

	p {
		margin: 0;
		font-size: 1rem;
		text-align: center;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--color);
		font-size: 1rem;
		text-decoration: none;
		border: 2px solid var(--border-color);
		border-radius: 7px;
		padding: 0.25rem 0.75rem;
	}

	.icon {
		width: 1.25em;
		height: 1.25em;
		flex-shrink: 0;
		fill: currentColor;
	}

	span.icon {
		background-color: currentColor;
		mask: var(--mask) center / contain no-repeat;
	}

	a:hover,
	a:focus-visible {
		border-color: var(--primary);
	}
</style>
