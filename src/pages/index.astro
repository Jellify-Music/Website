---
import { mdiApple, mdiGithub, mdiGooglePlay, mdiShieldAccount } from '@mdi/js'
import Layout from '../layouts/Layout.astro'

// `icon` is a Material Design Icons path; `mask` is an SVG in /public for brands MDI dropped
type Link = { label: string; href: string } & ({ icon: string } | { mask: string })

const links: Link[] = [
	{
		label: 'Play Store',
		icon: mdiGooglePlay,
		href: 'https://play.google.com/store/apps/details?id=com.cosmonautical.jellify',
	},
	{
		label: 'App Store',
		icon: mdiApple,
		href: 'https://apps.apple.com/us/app/jellify/id6736884612',
	},
	{
		label: 'Privacy Policy',
		icon: mdiShieldAccount,
		href: '/privacy',
	},
	{
		label: 'GitHub',
		icon: mdiGithub,
		href: 'https://github.com/Jellify-Music/App',
	},
	{
		label: 'Discord',
		href: 'https://discord.gg/yf8fBatktn',
		mask: '/discord.svg',
	},
]
---

<Layout>
	<main>
		<div class='logo' role='img' aria-label='Jellify'></div>

		<p>Website Under Construction...</p>

		<nav>
			{
				links.map((link) => (
					<a href={link.href}>
						{'icon' in link ? (
							<svg class='icon' viewBox='0 0 24 24' aria-hidden='true'>
								<path d={link.icon} />
							</svg>
						) : (
							<span class='icon' style={`--mask: url(${link.mask})`} aria-hidden='true' />
						)}
						{link.label}
					</a>
				))
			}
		</nav>
	</main>
</Layout>

<style>
	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 1.5rem;
	}

	/* The logo is single-color, so mask it and fill with the theme's text color */
	.logo {
		width: 180px;
		height: 180px;
		background-color: var(--color);
		mask: url(/jellifyBlack.svg) center / contain no-repeat;
	}

	p {
		margin: 0;
		font-size: 1rem;
		text-align: center;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--color);
		font-size: 1rem;
		text-decoration: none;
		border: 2px solid var(--border-color);
		border-radius: 7px;
		padding: 0.25rem 0.75rem;
	}

	.icon {
		width: 1.25em;
		height: 1.25em;
		flex-shrink: 0;
		fill: currentColor;
	}

	span.icon {
		background-color: currentColor;
		mask: var(--mask) center / contain no-repeat;
	}

	a:hover,
	a:focus-visible {
		border-color: var(--primary);
	}
</style>
