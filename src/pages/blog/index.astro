---
import { formatPostDate, getPosts, getPostSnippet } from '@/config/blog'
import Layout from '../../layouts/Layout.astro'

const posts = await getPosts()
---

<Layout title='Jellify - Blog' description='Updates and news from the Jellify team.'>
	<main>
		<div class='content'>
			<a class='back' href='/'>← Jellify</a>

			<h1>Blog</h1>
			<p class='meta'>
				Updates and news from the Jellify team. <a href='/blog/rss.xml'>RSS</a>
			</p>

			<ol>
				{
					posts.map((post) => (
						<li>
							<a class='post' href={`/blog/${post.id}`}>
								<time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>
								<h2>{post.data.title}</h2>
								<p>{getPostSnippet(post)}</p>
								<span class='more'>Read more →</span>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</main>
</Layout>

<style>
	main {
		padding: 3rem 1rem 4rem;
	}

	.content {
		max-width: 42rem;
		margin: 0 auto;
	}

	.back {
		font-weight: 600;
		text-decoration: none;
	}

	h1 {
		margin: 1.5rem 0 0;
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.meta {
		margin-top: 0.5rem;
		color: var(--neutral);
	}

	a {
		color: var(--primary);
	}

	ol {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post {
		display: block;
		color: var(--color);
		text-decoration: none;
		border: 2px solid var(--border-color);
		border-radius: 7px;
		padding: 1rem 1.25rem;
	}

	.post:hover,
	.post:focus-visible {
		border-color: var(--primary);
	}

	time {
		font-size: 0.875rem;
		color: var(--neutral);
	}

	h2 {
		margin: 0.25rem 0 0.5rem;
		font-size: 1.25rem;
		font-weight: 700;
	}

	.post p {
		margin: 0;
	}

	.more {
		display: inline-block;
		margin-top: 0.75rem;
		font-weight: 600;
		color: var(--primary);
	}
</style>
