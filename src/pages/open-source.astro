---
import { mdiGithub, mdiNpm, mdiScaleBalance, mdiStar, mdiWeb } from '@mdi/js'
import Icon from '@/components/Icon.astro'
import { getStarCount, openSourceProjects } from '@/config/openSource'
import Layout from '../layouts/Layout.astro'

const projects = await Promise.all(
	openSourceProjects.map(async (project) => ({ ...project, stars: await getStarCount(project.repo) })),
)
---

<Layout title='Jellify - Open Source' description='The open source projects that make up Jellify.'>
	<main>
		<header>
			<h1>Proudly open source</h1>
			<p class='lede'>
				Jellify is free and open source, along with the libraries we built to make it. Take a look, file
				an issue, or send a pull request.
			</p>
		</header>

		{
			projects.map((project) => (
				<section id={project.id} aria-labelledby={`${project.id}-heading`}>
					<div class='title'>
						<Icon path={project.icon} />
						<h2 id={`${project.id}-heading`}>{project.name}</h2>
					</div>

					{project.paragraphs.map((paragraph) => (
						<p>{paragraph}</p>
					))}

					<ul>
						{project.website && (
							<li>
								<a href={project.website}>
									<Icon path={mdiWeb} />
									Website
								</a>
							</li>
						)}

						<li>
							<a href={project.repo} aria-label={project.stars && `GitHub, ${project.stars} stars`}>
								<Icon path={mdiGithub} />
								GitHub
								{project.stars && (
									<span class='stars'>
										<Icon path={mdiStar} />
										{project.stars}
									</span>
								)}
							</a>
						</li>
						{project.npm && (
							<li>
								<a href={`https://www.npmjs.com/package/${project.npm}`}>
									<Icon path={mdiNpm} />
									<code>{project.npm}</code>
								</a>
							</li>
						)}
						<li class='license'>
							<Icon path={mdiScaleBalance} />
							{project.license} license
						</li>
					</ul>
				</section>
			))
		}
	</main>
</Layout>

<style>
	main {
		max-width: 42rem;
		margin: 0 auto;
		padding: 3rem 1rem 4rem;
	}

	h1 {
		margin: 0;
		font-size: 2.5rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.lede {
		margin: 0.75rem 0 0;
		font-size: 1.125rem;
		color: var(--neutral);
	}

	section {
		margin-top: 1.5rem;
		padding: 1.5rem;
		border-radius: 14px;
		background-color: var(--background-50);
		scroll-margin-top: 5rem;
	}

	header + section {
		margin-top: 2.5rem;
	}

	.title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.title :global(.icon) {
		width: 2rem;
		height: 2rem;
		color: var(--primary);
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 700;
	}

	p {
		margin: 0.75rem 0 0;
		color: var(--neutral);
	}

	ul {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	li {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		min-width: 0;
	}

	ul a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		min-width: 0;
		padding: 0.375rem 0.875rem;
		border: 2px solid var(--border-color);
		border-radius: 999px;
		color: var(--color);
		font-weight: 600;
		text-decoration: none;
	}

	ul a:hover,
	ul a:focus-visible {
		border-color: var(--primary);
	}

	ul a :global(.icon) {
		color: var(--primary);
	}

	.stars {
		display: inline-flex;
		align-items: center;
		gap: 0.125rem;
		margin-left: 0.25rem;
		padding-left: 0.625rem;
		border-left: 1px solid var(--border-color);
		color: var(--neutral);
	}

	code {
		font-size: 0.875em;
		overflow-wrap: anywhere;
	}

	.license {
		font-size: 0.9375rem;
		color: var(--neutral);
	}
</style>
